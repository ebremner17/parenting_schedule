<div class="wrapper-container">
  <div class="control-panel">
    <h3 class="control-panel-title">Schedule Administration</h3>

    <div class="add-month-controls">
      <select id="add-month-select">
        <option value="1">January</option>
        <option value="2">February</option>
        <option value="3">March</option>
        <option value="4">April</option>
        <option value="5">May</option>
        <option value="6">June</option>
        <option value="7">July</option>
        <option value="8">August</option>
        <option value="9">September</option>
        <option value="10">October</option>
        <option value="11">November</option>
        <option value="12">December</option>
      </select>
      <input type="number" id="add-month-year" value="2026" min="2000" max="2100">
      <button type="button" id="add-month-btn" class="btn-primary">Add Month</button>
    </div>

    <button type="button" onclick="exportJson()" class="btn-success">Export JSON</button>
    <button type="button" onclick="document.getElementById('import-file-input').click()" class="btn-info">Import JSON</button>
    <button type="button" onclick="clearSchedule()" class="btn-danger">Clear All</button>
    <input type="file" id="import-file-input" style="display: none;" accept=".json" onchange="importJson(event)">
  </div>

  <div class="control-panel">
    <h3 class="control-panel-title">Display Range</h3>
    <div class="range-controls">
      <div class="range-field">
        <label class="range-label">From</label>
        <div class="range-field-inputs">
          <select id="range-start-month">
            <option value="1">January</option>
            <option value="2">February</option>
            <option value="3">March</option>
            <option value="4">April</option>
            <option value="5">May</option>
            <option value="6">June</option>
            <option value="7">July</option>
            <option value="8">August</option>
            <option value="9">September</option>
            <option value="10">October</option>
            <option value="11">November</option>
            <option value="12">December</option>
          </select>
          <input type="number" id="range-start-year" value="2026" min="2000" max="2100">
        </div>
      </div>
      <div class="range-field">
        <label class="range-label">To</label>
        <div class="range-field-inputs">
          <select id="range-end-month">
            <option value="1">January</option>
            <option value="2">February</option>
            <option value="3">March</option>
            <option value="4">April</option>
            <option value="5">May</option>
            <option value="6">June</option>
            <option value="7">July</option>
            <option value="8">August</option>
            <option value="9">September</option>
            <option value="10">October</option>
            <option value="11">November</option>
            <option value="12">December</option>
          </select>
          <input type="number" id="range-end-year" value="2026" min="2000" max="2100">
        </div>
      </div>
      <button type="button" id="range-apply-btn" class="btn-primary">Show Range</button>
      <button type="button" id="range-reset-btn" class="btn-secondary">Show All</button>
    </div>
  </div>

  <div class="analysis-card">
    <h2>Schedule Summary & Totals</h2>
    <table class="summary-table">
      <thead>
      <tr>
        <th>Month</th>
        <th>Days</th>
        <th>Eric</th>
        <th>Sarah</th>
        <th>Variance</th>
      </tr>
      </thead>
      <tbody id="summary-table-body"></tbody>
      <tfoot id="summary-table-foot"></tfoot>
    </table>
  </div>

  <div id="calendars-wrapper"></div>
</div>

<div id="modal" class="modal-overlay">
  <div class="modal-content">
    <h3 id="modal-date-title">Edit Date</h3>
    <input type="hidden" id="modal-date-val">

    <label class="field-label">Type of Day</label>
    <input type="text" id="modal-occasion" placeholder="e.g. Christmas Day, Easter, Halloween, PA Day">

    <div class="day-type-toggle">
      <label><input type="radio" name="day-type" value="exchange" checked> Exchange Day</label>
      <label><input type="radio" name="day-type" value="parenting"> Parenting Day</label>
    </div>

    <div id="exchange-section" class="modal-section">
      <label class="field-label">Exchange Time</label>
      <input type="time" id="modal-exchange-time" value="16:00">

      <label class="field-label">Exchange Direction</label>
      <div class="radio-row">
        <label><input type="radio" name="exchange-type" value="eric_to_sarah" checked> Eric &rarr; Sarah</label>
        <label><input type="radio" name="exchange-type" value="sarah_to_eric"> Sarah &rarr; Eric</label>
      </div>
    </div>

    <div id="parenting-section" class="modal-section" style="display: none;">
      <label class="field-label">Parent</label>
      <div class="radio-row">
        <label><input type="radio" name="parent" value="eric" checked> Eric</label>
        <label><input type="radio" name="parent" value="sarah"> Sarah</label>
      </div>
    </div>

    <label class="field-label">Label</label>
    <select id="modal-label-select">
      <option value="">None</option>
      <option value="Nights">Nights</option>
      <option value="Makeup day">Makeup day</option>
      <option value="Hunting">Hunting</option>
      <option value="Vacation">Vacation</option>
      <option value="March Break">March Break</option>
      <option value="Balancing">Balancing</option>
      <option value="custom">Custom</option>
    </select>
    <input type="text" id="modal-label-custom" placeholder="Enter custom label" style="display: none; margin-top: 8px;">

    <div class="modal-actions">
      <button type="button" id="modal-delete-btn" class="btn-danger" onclick="deleteDay()">Clear Day</button>
      <span class="modal-actions-spacer"></span>
      <button type="button" class="btn-secondary" onclick="closeModal()">Cancel</button>
      <button type="button" class="btn-primary" onclick="saveDay()">Save</button>
    </div>
  </div>
</div>
